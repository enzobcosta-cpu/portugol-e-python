/*
    Exercício 01 — Boas-vindas
    Aluno: Enzo Bernardo
    Objetivo: ler o nome e dar uma mensagem de boas-vindas.
*/
programa
{
    funcao inicio()
    {
        // Entrada: agora vai pegar o nome que a pessoa vai digitar.
        cadeia nome
        escreva("Digite seu nome: ")
        leia(nome)

        // Saída: mostra uma mensagem de boas-vindas.
        escreva("Olá, ", nome, "! Bem-vindo(a) ao curso de Desenvolvimento de Sistemas.\n")
    }
}
